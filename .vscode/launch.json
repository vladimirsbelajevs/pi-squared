{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug SvelteKit in Flatpak Chrome",
			"type": "chrome",
			"request": "launch",
			"runtimeExecutable": "/var/lib/flatpak/exports/bin/com.google.Chrome",
			"url": "http://127.0.0.1:5173",
			"userDataDir": "${env:HOME}/.var/app/com.google.Chrome/cache/vscode-debug",
			"webRoot": "${workspaceFolder}",
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"preLaunchTask": "Start SvelteKit dev server"
		}
	]
}
