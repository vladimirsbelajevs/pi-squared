{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Attach SvelteKit to Flatpak Chrome",
			"type": "chrome",
			"request": "attach",
			"port": 9222,
			"urlFilter": "http://127.0.0.1:5173/*",
			"webRoot": "${workspaceFolder}",
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
			"preLaunchTask": "Start SvelteKit debugger"
		}
	]
}
