{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start SvelteKit dev server",
			"type": "shell",
			"command": "npm run dev -- --host 127.0.0.1 --port 5173",
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": [
					{
						"regexp": "^(?!.*)((.*))$",
						"kind": "file",
						"file": 1,
						"message": 2
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "\\bLocal:\\s+http://127\\.0\\.0\\.1:5173/"
				}
			}
		},
		{
			"label": "Stop SvelteKit dev server",
			"type": "shell",
			"command": "fuser --kill 5173/tcp || true",
			"problemMatcher": []
		}
	]
}
