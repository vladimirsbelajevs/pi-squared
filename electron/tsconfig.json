{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "..",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"noEmit": false,
		"declaration": false,
		"sourceMap": true
	},
	"include": ["./*.ts", "./*.cts", "../src/lib/desktop-contract.ts"],
	"exclude": ["./*.spec.ts", "../src/**/*.spec.ts", "../src/**/*.svelte.spec.ts"]
}
