[
	{
		"label": "Debug SvelteKit in Flatpak Chrome",
		"adapter": "JavaScript",
		"type": "chrome",
		"request": "launch",
		"runtimeExecutable": "/var/lib/flatpak/exports/bin/com.google.Chrome",
		"runtimeArgs": ["--remote-debugging-address=127.0.0.1", "--remote-debugging-port=9222"],
		"url": "http://127.0.0.1:5173",
		"webRoot": "$ZED_WORKTREE_ROOT",
		"resolveSourceMapLocations": ["$ZED_WORKTREE_ROOT/**", "!**/node_modules/**"],
		"build": "Start SvelteKit dev server"
	}
]
