{
  "mcpServers": {
    "svelte": {
      "type": "stdio",
      "command": "npx",
      "env": {},
      "args": [
        "-y",
        "@sveltejs/mcp"
      ]
    },
    "pi-squared-storybook-mcp": {
      "url": "http://localhost:6006/mcp",
      "type": "http"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
